{
  "name": "@relo/owner-client",
  "version": "0.18.115",
  "private": true,
  "description": "The device-side client an owner-overview device (the Windows notch) uses to join a Relo server, read Now and answer questions.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "package.json"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @relo/notification-contracts build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @relo/notification-contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @relo/notification-contracts build",
    "test": "vitest run"
  },
  "dependencies": {
    "@relo/notification-contracts": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
