#!/usr/bin/env bash
# Runs only the checks the commits being pushed need: everything since the upstream (or origin/main).
cd "$(git rev-parse --show-toplevel)" || exit 1
base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)"
exec node scripts/check-changed.mjs --since "$base"
