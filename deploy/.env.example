# The exact HTTPS origin browsers and the iPhone use, e.g. https://relo.example.com
RELO_APP_URL=http://127.0.0.1:8180
# Behind a reverse proxy, the header it writes the real client address into
# (cf-connecting-ip for Cloudflare Tunnel, x-real-ip for nginx). Leave empty without a proxy.
RELO_CLIENT_IP_HEADER=
# Optional: an https folder holding a launch film (relo-launch-{av1,hevc,h264}.mp4 and poster.jpg) to show
# under the landing hero. Unset, the landing has no film.
RELO_LANDING_FILM_URL=
# Optional: the same for the onboarding film (relo-onboarding-*.mp4 and poster.jpg), shown above Get started.
RELO_ONBOARDING_FILM_URL=
RELO_BIND_ADDRESS=127.0.0.1
RELO_PORT=8180
# Set both to the release you deploy (the server version, e.g. 1.2.3); they must match.
RELO_RELEASE_IDENTITY=replace-with-the-release-version
RELO_IMAGE_TAG=replace-with-the-release-version
RELO_UID=1000
RELO_GID=1000
BOOTSTRAP_OWNER_HANDLE=owner
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-hex-value
APNS_MODE=disabled
# Hours after which ended content (notifications, answered questions, ended cards) is deleted from the
# server (1-8760). 10 is Relo's default promise; empty keeps content until you run the retention tool (see docs/SELF-HOSTING.md).
RELO_CONTENT_RETENTION_HOURS=10
